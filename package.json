{
  "name": "@chord-dht-tracker/monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-spa-shell-stub.mjs && pnpm run typegen",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config test/integration/vitest.config.mts",
    "test:coverage:integration": "vitest run --coverage --config test/integration/vitest.config.mts",
    "lint": "eslint --fix --quiet .",
    "prettier": "prettier --write .",
    "checks": "pnpm -r typecheck && pnpm run lint && pnpm run test",
    "dev": "wrangler dev --config apps/api/wrangler.template.jsonc",
    "deploy": "pnpm run build && wrangler deploy",
    "typegen": "wrangler types --config ./apps/api/wrangler.template.jsonc --env-interface CloudflareEnv",
    "migrate:local": "wrangler d1 migrations apply chord-dht-tracker-db --local --config apps/api/wrangler.template.jsonc",
    "migrate:remote": "wrangler d1 migrations apply chord-dht-tracker-db --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "4.1.10",
    "chanfana": "3.4.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-unicorn": "74.0.0",
    "globals": "^17.12.0",
    "hono": "^4.13.8",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.10",
    "wrangler": "^4.136.2",
    "zod": "4.6.5"
  },
  "packageManager": "pnpm@11.2.2"
}
